{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "server/**",
      "supabase/functions/postiz/**",
      "package.json",
      "package-lock.json",
      "*.html",
      "public/**",
      "vite.config.ts",
      ".dockerignore",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS"
  }
}
