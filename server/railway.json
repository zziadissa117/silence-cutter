{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/Dockerfile",
    "watchPatterns": ["src/**", "server/**", "supabase/functions/postiz/**", "package.json", "package-lock.json", "*.html", "public/**", "vite.config.ts", ".dockerignore"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS"
  }
}
